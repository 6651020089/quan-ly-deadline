// 7. CÁC HÀM TÌM KIẾM

// Chuyển chữ thường
string vietThuong(string s){

    for(int i = 0; i < s.length(); i++){

        s[i] = tolower(s[i]);
    }

    return s;
}


// In công việc
void inTask(CongViec cv){

    cout << "\nMa: "
         << cv.ma;

    cout << "\nTen: "
         << cv.ten;

    cout << "\nMon hoc: "
         << cv.monHoc;

    cout << "\nHan chot: "
         << cv.hanChot;

    cout << "\nDo uu tien: "
         << cv.doUuTien;

    cout << "\nTrang thai: ";


    if(cv.daHoanThanh){

        cout << "Da hoan thanh";
    }
    else{

        cout << "Chua hoan thanh";
    }

    cout << "\n--------------------------------------";
}


// Tìm theo tên
void timTheoTen(
    Slist &danhSach,
    string tuKhoa
){

    Node *p = danhSach.head;

    bool timThay = false;

    tuKhoa = vietThuong(tuKhoa);


    while(p != NULL){

        int ma = p->data;

        int viTri = timViTriCongViec(ma);


        if(viTri != -1){

            string ten =
            vietThuong(
                danhSachCongViec[viTri].ten
            );


            if(
                ten.find(tuKhoa)
                != string::npos
            ){

                inTask(
                    danhSachCongViec[viTri]
                );

                timThay = true;
            }
        }


        p = p->next;
    }


    if(!timThay){

        cout << "\nKhong tim thay!\n";
    }
}


