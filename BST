typedef struct nutcay{

    CongViec data;

    struct nutcay *left;

    struct nutcay *right;

}NutCay;


typedef struct caydeadline{
public:
    NutCay *root;
    int size;

    void khoiTao();
    NutCay *taoNut(CongViec cv);
    NutCay *themNode(NutCay *p, CongViec cv);
    void them(CongViec cv);

    void duyetLNR(NutCay *p);
    void duyetNLR(NutCay *p);
    void duyetLRN(NutCay *p);

    void tangDan();
    void giamDan();

    void hienThi();

    void xoaCay(NutCay *p);
    void xoaHet();
}CayDeadline;
// Khởi tạo cây
void CayDeadline::khoiTao(){

    root = NULL;

    size = 0;
}


// Tạo Node
NutCay *CayDeadline::taoNut(CongViec cv){

    NutCay *p = new NutCay;

    p->data = cv;

    p->left = NULL;

    p->right = NULL;

    return p;
}
// Thêm Node vào BST
NutCay *CayDeadline::themNode(
    NutCay *p,
    CongViec cv
){

    if(p == NULL){

        size++;

        return taoNut(cv);
    }


    if(cv.hanChot < p->data.hanChot){

        p->left =
        themNode(p->left, cv);
    }
    else{

        p->right =
        themNode(p->right, cv);
    }


    return p;
}


// Thêm vào cây
void CayDeadline::them(CongViec cv){

    root = themNode(root, cv);
}
// Duyệt LNR
void CayDeadline::duyetLNR(NutCay *p){

    if(p == NULL){

        return;
    }


    duyetLNR(p->left);


    cout << "\nMa: "
         << p->data.ma;

    cout << " | Ten: "
         << p->data.ten;

    cout << " | Han: "
         << p->data.hanChot;


    duyetLNR(p->right);
}
// Duyệt NLR
void CayDeadline::duyetNLR(NutCay *p){

    if(p == NULL){

        return;
    }


    cout << "\nMa: "
         << p->data.ma;

    cout << " | Ten: "
         << p->data.ten;

    cout << " | Han: "
         << p->data.hanChot;


    duyetNLR(p->left);

    duyetNLR(p->right);
}


// Duyệt LRN
void CayDeadline::duyetLRN(NutCay *p){

    if(p == NULL){

        return;
    }


    duyetLRN(p->left);

    duyetLRN(p->right);


    cout << "\nMa: "
         << p->data.ma;

    cout << " | Ten: "
         << p->data.ten;

    cout << " | Han: "
         << p->data.hanChot;
}
// Deadline tăng dần
void CayDeadline::tangDan(){

    cout << "\n========== DEADLINE TANG DAN ==========\n";

    duyetLNR(root);

    cout << "\n";
}


// Deadline giảm dần
void CayDeadline::giamDan(){

    cout << "\n========== DEADLINE GIAM DAN ==========\n";

    // RNL
    stack<NutCay*> nganXep;

    NutCay *p = root;


    while(p != NULL || !nganXep.empty()){

        while(p != NULL){

            nganXep.push(p);

            p = p->right;
        }


        p = nganXep.top();

        nganXep.pop();


        cout << "\nMa: "
             << p->data.ma;

        cout << " | Ten: "
             << p->data.ten;

        cout << " | Han: "
             << p->data.hanChot;


        p = p->left;
    }

    cout << "\n";
}
void CayDeadline::hienThi(){
    if(root == NULL){
        cout << "Cay dang rong!\n";
        return;
    }

    cout << "\nDANH SACH CONG VIEC THEO DEADLINE TANG DAN:\n";
    duyetLNR(root);
}

// Xóa cây
void CayDeadline::xoaCay(NutCay *p){

    if(p == NULL){

        return;
    }


    xoaCay(p->left);

    xoaCay(p->right);

    delete p;
}


// Xóa toàn bộ cây
void CayDeadline::xoaHet(){

    xoaCay(root);

    root = NULL;

    size = 0;
}
