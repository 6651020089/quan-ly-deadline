#include <iostream>
#include <string>
#include <algorithm>
#include <cctype>

using namespace std;

// Cau truc luu thong tin cong viec
struct CongViec {
    string ten;
    string mon;
    bool hoanThanh;
    int uuTien;
    CongViec* tiepTheo;

    CongViec(string t, string m, bool ht, int ut) {
        ten = t;
        mon = m;
        hoanThanh = ht;
        uuTien = ut;
        tiepTheo = nullptr;
    }
};

// Ham chuyen chu hoa thanh chu thuong
string vietThuong(string vanBan) {
    transform(
        vanBan.begin(),
        vanBan.end(),
        vanBan.begin(),
        [](unsigned char kyTu) {
            return static_cast<char>(tolower(kyTu));
        }
    );

    return vanBan;
}

// Ham in thong tin cong viec
void inCongViec(CongViec* congViec) {
    if (congViec == nullptr) {
        cout << "Cong viec khong ton tai!\n";
        return;
    }

    cout << "\n";
    cout << "----------------------------------------\n";
    cout << "Ten cong viec : " << congViec->ten << endl;
    cout << "Mon / Chu de  : " << congViec->mon << endl;

    cout << "Trang thai    : ";
    if (congViec->hoanThanh)
        cout << "Da hoan thanh";
    else
        cout << "Chua hoan thanh";

    cout << endl;
    cout << "Do uu tien    : ";

    switch (congViec->uuTien) {
        case 1:
            cout << "Thap";
            break;
        case 2:
            cout << "Trung binh";
            break;
        case 3:
            cout << "Cao";
            break;
        default:
            cout << "Khong xac dinh";
    }

    cout << endl;
    cout << "----------------------------------------\n";
}

// Ham them cong viec vao danh sach lien ket
void themCongViec(CongViec*& dau,
                  string ten, string mon,
                  bool hoanThanh, int uuTien) {
    CongViec* congViecMoi =
        new CongViec(ten, mon, hoanThanh, uuTien);

    if (dau == nullptr) {
        dau = congViecMoi;
        return;
    }

    CongViec* hienTai = dau;

    while (hienTai->tiepTheo != nullptr) {
        hienTai = hienTai->tiepTheo;
    }

    hienTai->tiepTheo = congViecMoi;
}

// Ham tim cong viec theo ten
void timTheoTen(CongViec* dau, string tenCanTim) {
    bool timThay = false;

    tenCanTim = vietThuong(tenCanTim);

    CongViec* hienTai = dau;

    while (hienTai != nullptr) {
        string tenCongViec = vietThuong(hienTai->ten);

        if (tenCongViec.find(tenCanTim) != string::npos) {
            inCongViec(hienTai);
            timThay = true;
        }

        hienTai = hienTai->tiepTheo;
    }

    if (!timThay) {
        cout << "\nKhong tim thay cong viec co ten: "
             << tenCanTim << endl;
    }
}

// Ham tim cong viec theo mon hoc / chu de
void timTheoMon(CongViec* dau, string monCanTim) {
    bool timThay = false;

    monCanTim = vietThuong(monCanTim);

    CongViec* hienTai = dau;

    while (hienTai != nullptr) {
        string monCongViec = vietThuong(hienTai->mon);

        if (monCongViec.find(monCanTim) != string::npos) {
            inCongViec(hienTai);
            timThay = true;
        }

        hienTai = hienTai->tiepTheo;
    }

    if (!timThay) {
        cout << "\nKhong tim thay cong viec thuoc mon: "
             << monCanTim << endl;
    }
}

// Ham loc cong viec theo trang thai
void locTheoTrangThai(CongViec* dau, bool hoanThanh) {
    bool timThay = false;

    CongViec* hienTai = dau;

    while (hienTai != nullptr) {
        if (hienTai->hoanThanh == hoanThanh) {
            inCongViec(hienTai);
            timThay = true;
        }

        hienTai = hienTai->tiepTheo;
    }

    if (!timThay) {
        if (hoanThanh) {
            cout << "\nKhong co cong viec da hoan thanh.\n";
        } else {
            cout << "\nKhong co cong viec chua hoan thanh.\n";
        }
    }
}

// Ham giai phong bo nho
void giaiPhongBoNho(CongViec*& dau) {
    while (dau != nullptr) {
        CongViec* tam = dau;
        dau = dau->tiepTheo;
        delete tam;
    }
}

// Ham main
int main() {
    CongViec* dau = nullptr;

    // Them du lieu mau
    themCongViec(dau, "Lam bai tap C++",
                 "Lap trinh", false, 3);

    themCongViec(dau, "Lam bao cao",
                 "CSDL", true, 2);

    themCongViec(dau, "On tap Linked List",
                 "Lap trinh", false, 3);

    // Hien thi danh sach cong viec
    cout << "===== DANH SACH CONG VIEC =====\n";

    CongViec* hienTai = dau;

    while (hienTai != nullptr) {
        inCongViec(hienTai);
        hienTai = hienTai->tiepTheo;
    }

    // Tim kiem theo ten
    string tenCanTim;

    cout << "\nNhap ten cong viec can tim: ";
    getline(cin, tenCanTim);

    timTheoTen(dau, tenCanTim);

    // Tim kiem theo mon hoc
    string monCanTim;

    cout << "\nNhap mon / chu de can tim: ";
    getline(cin, monCanTim);

    timTheoMon(dau, monCanTim);

    // Loc cong viec da hoan thanh
    cout << "\n===== CONG VIEC DA HOAN THANH =====\n";
    locTheoTrangThai(dau, true);

    // Loc cong viec chua hoan thanh
    cout << "\n===== CONG VIEC CHUA HOAN THANH =====\n";
    locTheoTrangThai(dau, false);

    // Giai phong bo nho
    giaiPhongBoNho(dau);

    return 0;
}
