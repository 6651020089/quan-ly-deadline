#include <iostream>
#include <string>
#include <algorithm>
#include <cctype>

using namespace std;

// Cau truc luu thong tin cong viec
struct TaskNode {
    string name;
    string subject;
    bool completed;
    int priority;
    TaskNode* next;

    TaskNode(string n, string s, bool c, int p) {
        name = n;
        subject = s;
        completed = c;
        priority = p;
        next = nullptr;
    }
};

// Ham chuyen chu hoa thanh chu thuong
string vietThuong(string text) {
    transform(
        text.begin(),
        text.end(),
        text.begin(),
        [](unsigned char c) {
            return static_cast<char>(tolower(c));
        }
    );

    return text;
}

// Ham in thong tin mot cong viec
void inTask(TaskNode* task) {
    if (task == nullptr) {
        cout << "Cong viec khong ton tai!\n";
        return;
    }

    cout << "\n";
    cout << "----------------------------------------\n";
    cout << "Ten cong viec : " << task->name << endl;
    cout << "Mon / Chu de  : " << task->subject << endl;

    cout << "Trang thai    : ";
    if (task->completed)
        cout << "Da hoan thanh";
    else
        cout << "Chua hoan thanh";

    cout << endl;
    cout << "Do uu tien    : ";

    switch (task->priority) {
        case 1:
            cout << "Thap";
            break;
        case 2:
            cout << "Trung binh";
            break;
        case 3:
            cout << "Cao";
            break;
        default:
            cout << "Khong xac dinh";
    }

    cout << endl;
    cout << "----------------------------------------\n";
}

// Ham them cong viec vao danh sach lien ket
void addTask(TaskNode*& head, string name,
             string subject, bool completed, int priority) {
    TaskNode* newTask =
        new TaskNode(name, subject, completed, priority);

    if (head == nullptr) {
        head = newTask;
        return;
    }

    TaskNode* current = head;

    while (current->next != nullptr) {
        current = current->next;
    }

    current->next = newTask;
}

// Ham tim kiem cong viec theo ten
void timTheoTen(TaskNode* head, string tenCanTim) {
    bool found = false;

    tenCanTim = vietThuong(tenCanTim);

    TaskNode* current = head;

    while (current != nullptr) {
        string tenCongViec = vietThuong(current->name);

        if (tenCongViec.find(tenCanTim) != string::npos) {
            inTask(current);
            found = true;
        }

        current = current->next;
    }

    if (!found) {
        cout << "\nKhong tim thay cong viec co ten: "
             << tenCanTim << endl;
    }
}

// Ham giai phong bo nho danh sach lien ket
void deleteAll(TaskNode*& head) {
    while (head != nullptr) {
        TaskNode* temp = head;
        head = head->next;
        delete temp;
    }
}

// Ham main
int main() {
    // Tao danh sach cong viec
    TaskNode* head = nullptr;

    addTask(head, "Lam bai tap C++", "Lap trinh", false, 3);
    addTask(head, "Lam bao cao", "CSDL", true, 2);
    addTask(head, "On tap Linked List", "Lap trinh", false, 3);

    // Hien thi tat ca cong viec
    cout << "===== DANH SACH CONG VIEC =====\n";

    TaskNode* current = head;
    while (current != nullptr) {
        inTask(current);
        current = current->next;
    }

    // Nhap ten cong viec can tim
    string tenCanTim;

    cout << "\nNhap ten cong viec can tim: ";
    getline(cin, tenCanTim);

    // Goi ham tim kiem
    timTheoTen(head, tenCanTim);

    // Giai phong bo nho
    deleteAll(head);

    return 0;
}
