// ============================================================
// GIẢI PHÓNG LINKED LIST
// ============================================================

void deleteAll(
    TaskNode*& head
) {

    TaskNode* current = head;

    while (current != nullptr) {

        TaskNode* temp =
            current;

        current =
            current->next;

        delete temp;
    }

    head = nullptr;
}


