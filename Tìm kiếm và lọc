// ============================================================
// CẤU TRÚC TASK
// ============================================================

struct TaskNode {
    string name;        // Tên công việc
    string subject;     // Môn học / chủ đề
    bool completed;     // true = đã hoàn thành
    int priority;       // 1 = thấp, 2 = trung bình, 3 = cao

    TaskNode* next;

    TaskNode(
        string n,
        string s,
        bool c,
        int p
    ) {
        name = n;
        subject = s;
        completed = c;
        priority = p;
        next = nullptr;
    }
};


// ============================================================
// HÀM IN TASK
// ============================================================

void printTask(TaskNode* task) {

    cout << "\n";
    cout << "----------------------------------------\n";

    cout << "Ten cong viec : "
         << task->name << endl;

    cout << "Mon / Chu de  : "
         << task->subject << endl;

    cout << "Trang thai     : ";

    if (task->completed)
        cout << "Da hoan thanh";
    else
        cout << "Chua hoan thanh";

    cout << endl;

    cout << "Do uu tien     : ";

    switch (task->priority) {

        case 1:
            cout << "Thap";
            break;

        case 2:
            cout << "Trung binh";
            break;

        case 3:
            cout << "Cao";
            break;

        default:
            cout << "Khong xac dinh";
    }

    cout << endl;

    cout << "----------------------------------------\n";
}


// ============================================================
// HÀM CHUYỂN CHỮ THƯỜNG
// ============================================================

string toLowerCase(string text) {

    transform(
        text.begin(),
        text.end(),
        text.begin(),
        [](unsigned char c) {
            return static_cast<char>(tolower(c));
        }
    );

    return text;
}


// ============================================================
// 1. TÌM THEO TÊN
// ============================================================

void searchByName(
    TaskNode* head,
    string keyword
) {

    bool found = false;

    keyword = toLowerCase(keyword);

    TaskNode* current = head;

    while (current != nullptr) {

        string taskName =
            toLowerCase(current->name);

        if (
            taskName.find(keyword)
            != string::npos
        ) {

            printTask(current);

            found = true;
        }

        current = current->next;
    }

    if (!found) {

        cout << "\n";
        cout << "Khong tim thay cong viec co ten: "
             << keyword << endl;
    }
}


// ============================================================
// 2. TÌM THEO MÔN / CHỦ ĐỀ
// ============================================================

void searchBySubject(
    TaskNode* head,
    string subject
) {

    bool found = false;

    subject = toLowerCase(subject);

    TaskNode* current = head;

    while (current != nullptr) {

        string currentSubject =
            toLowerCase(current->subject);

        if (
            currentSubject.find(subject)
            != string::npos
        ) {

            printTask(current);

            found = true;
        }

        current = current->next;
    }

    if (!found) {

        cout << "\n";
        cout << "Khong tim thay cong viec thuoc mon: "
             << subject << endl;
    }
}


// ============================================================
// 3. LỌC THEO TRẠNG THÁI
// ============================================================

void filterByStatus(
    TaskNode* head,
    bool completed
) {

    bool found = false;

    TaskNode* current = head;

    while (current != nullptr) {

        if (
            current->completed == completed
        ) {

            printTask(current);

            found = true;
        }

        current = current->next;
    }

    if (!found) {

        if (completed) {

            cout << "\n";
            cout << "Khong co cong viec da hoan thanh.\n";

        } else {

            cout << "\n";
            cout << "Khong co cong viec chua hoan thanh.\n";
        }
    }
}


// ============================================================
// 4. LỌC THEO ĐỘ ƯU TIÊN
// ============================================================

void filterByPriority(
    TaskNode* head,
    int priority
) {

    bool found = false;

    TaskNode* current = head;

    while (current != nullptr) {

        if (
            current->priority == priority
        ) {

            printTask(current);

            found = true;
        }

        current = current->next;
    }

    if (!found) {

        cout << "\n";
        cout << "Khong co cong viec voi muc uu tien "
             << priority << ".\n";
    }
}


// ============================================================
// 5. ĐẾM TASK ĐÃ HOÀN THÀNH
// ============================================================

int countCompleted(
    TaskNode* head
) {

    int count = 0;

    TaskNode* current = head;

    while (current != nullptr) {

        if (current->completed) {
            count++;
        }

        current = current->next;
    }

    return count;
}


// ============================================================
// 6. ĐẾM TASK CHƯA HOÀN THÀNH
// ============================================================

int countUncompleted(
    TaskNode* head
) {

    int count = 0;

    TaskNode* current = head;

    while (current != nullptr) {

        if (!current->completed) {
            count++;
        }

        current = current->next;
    }

    return count;
}


// ============================================================
// 7. ĐẾM TASK THEO ĐỘ ƯU TIÊN
// ============================================================

int countPriority(
    TaskNode* head,
    int priority
) {

    int count = 0;

    TaskNode* current = head;

    while (current != nullptr) {

        if (
            current->priority == priority
        ) {

            count++;
        }

        current = current->next;
    }

    return count;
}


// ============================================================
// 8. HIỂN THỊ THỐNG KÊ
// ============================================================

