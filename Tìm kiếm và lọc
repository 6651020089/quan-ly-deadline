// ============================================================
// THÊM TASK
// ============================================================

void addTask(
    TaskNode*& head,
    string name,
    string subject,
    bool completed,
    int priority
) {

    TaskNode* newTask =
        new TaskNode(
            name,
            subject,
            completed,
            priority
        );


    if (head == nullptr) {

        head = newTask;

        return;
    }


    TaskNode* current = head;


    while (
        current->next != nullptr
    ) {

        current =
            current->next;
    }


    current->next =
        newTask;
}


// ============================================================
// HIỂN THỊ TẤT CẢ TASK
// ============================================================

void displayAll(
    TaskNode* head
) {

    if (head == nullptr) {

        cout << "\nDanh sach cong viec rong.\n";

        return;
    }


    TaskNode* current = head;


    while (current != nullptr) {

        printTask(current);

        current =
            current->next;
    }
}


