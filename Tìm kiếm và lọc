
#include <iostream>
#include <string>
#include <algorithm>
#include <cctype>

using namespace std;

// Hàm chuyển chữ hoa thành chữ thường
string vietThuong(string text) {
    transform(
        text.begin(),
        text.end(),
        text.begin(),
        [](unsigned char c) {
            return static_cast<char>(tolower(c));
        }
    );

    return text;
}
