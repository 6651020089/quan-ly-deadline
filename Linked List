typedef struct node{
int data;
struct node *next;
}Node;
tupedef struct slist{
public:
Node *head;
Node *tail;
int size;
void init();
Node *createNode(int x);
void themDau(int x);
void themCuoi(int x);
Node *timTheoMa(int x);
bool xoaTheoMa(int x);
void hienthi();
int soluong();
}Slist;
void Slist::init(){
head =NULL;
tail=NULL;
size =0;
}
Node *Slist::createNode(int x){
Node *p = new Node;
p->data=x;
p->next=NULL;
return p;
}
void Slist::themDau(int x){
Node *p =createNode(x);
if(head ==NULL){
head = p;
tail =p;
}
else{
p->next =head;
head p;
}
size ++;
}
void Slist::themCuoi(int x){
Node *p= createNode(x);
if(head==NULL){
head=p;
tail=p;
}
else{
tail->next=p;
tail=p;
}
size++
}
Node *Slist::timTheoMa(int x){
Node *p= head;
While(p !=NULL)[
if(p->data==x){
return p;
}
p=p->next;
}
return NULL;
}
bool Slist::xoaTheoMa(int x){

    if(head == NULL){
        return false;
    }
    if(head->data == x){
        Node *p = head;
        head = head->next;
        delete p;
        size--;
        if(head == NULL){
            tail = NULL;
        }
        return true;
    }
    Node *p = head;
    while(p->next != NULL){
        if(p->next->data == x){
            Node *q = p->next;
            p->next = q->next;
            if(q == tail){
                tail = p;
            }
            delete q;
            size--;
            return true;
        }
        p = p->next;
    }
    return false;
}


