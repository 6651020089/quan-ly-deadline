typedef struct nodeQueue{
      Congviec data;
     struct nodeQueue *next;
}NodeQueue;
typedef struct hangdoi{
     public:
     NodeQueue *head;
     NodeQueue *tail;
     int size;
     void khoiTao();
     bool rong();
     void them(Congviec cv);
     Congviec layRa();
     void hienThi();
     void xoaHet();
     int soLuong();    
}HangDoiDeadLine;
// Khởi tạo  Queue
void HangDoiDeadLine::khoiTao(){
     head=NULL;
     tail=NULL;
     size=0;   
}
// Kiểm tra rỗng
bool HangDoiDeadLine::rong(){
     return head=NULL;
}
// Thêm vào cuối Queue
void HangDoiDeadLine::them(Congviec cv){
     NodeQueue *p= new NodeQueue;
     p->data=cv;
     p->next=NULL;
     if(head == NULL){
        head=p;
        tail=p;
 }
     else {
      tail->next=p;
      tail=p;
     }
  size++;
}
Congviec HangDoiDeadLine::layRa(){
      Congviec rong;
      rong.ma=-1;
     if (head==NULL){
        return rong;
}
     NodeQueue *p= head;
     Congviec cv = p->data;
     head = head ->next;
     delete p;
     size--; 
     if ( head == NULL){
        tail = NULL;
   }
      return cv;
}
void HangDoiDeadLine::hienThi(){
       if (head == NULL){
           cout<<" \nHang doi rong!\n";
       return ;
}
    NodeQueue *p = head ;
    cout <<"\n========== HANG DOI DEADLINE ==========\n";
    
  while(p != NULL){

        cout << "\nMa: "
             << p->data.ma;

        cout << "\nTen: "
             << p->data.ten;

        cout << "\nMon: "
             << p->data.monHoc;

        cout << "\nHan: "
             << p->data.hanChot;

        cout << "\n---------------------------------------";

        p = p->next;
    }
    cout << "\n";
}
void HangDoiDeadline::xoaHet(){
    while(head != NULL){
        NodeQueue *p = head;
        head = head->next;
        delete p;
    }
    tail = NULL;
    size = 0;
}
int HangDoiDeadline::soLuong(){
    return size;
}
