struct LichSu{

    string hanhDong;

    CongViec congViec;
};


typedef struct nodeStack{

    LichSu data;

    struct nodeStack *next;

}NodeStack;


typedef struct nganxep{

public:

    NodeStack *top;

    int size;

    void khoiTao();

    bool rong();

    void them(LichSu x);

    LichSu layRa();

    void hienThi();

    void xoaHet();

    int soLuong();

}NganXepLichSu;


// Khởi tạo Stack
void NganXepLichSu::khoiTao(){


    top = NULL;

    size = 0;
}
// Kiểm tra rỗng
bool NganXepLichSu::rong(){

    return top == NULL;
}
// Thêm vào Stack
void NganXepLichSu::them(LichSu x){

    NodeStack *p = new NodeStack;

    p->data = x;

    p->next = top;

    top = p;

    size++;
}
// Lấy phần tử trên cùng
LichSu NganXepLichSu::layRa(){

    LichSu rong;

    rong.hanhDong = "";

    rong.congViec.ma = -1;


    if(top == NULL){

        return rong;
    }


    NodeStack *p = top;

    LichSu x = p->data;

    top = top->next;

    delete p;

    size--;

    return x;
}
// Hiển thị Stack
void NganXepLichSu::hienThi(){

    if(top == NULL){

        cout << "\nLich su rong!\n";

        return;
    }


    NodeStack *p = top;

    cout << "\n========== LICH SU ==========\n";


    while(p != NULL){

        cout << "\nHanh dong: "
             << p->data.hanhDong;

        cout << "\nMa cong viec: "
             << p->data.congViec.ma;

        cout << "\nTen: "
             << p->data.congViec.ten;

        cout << "\n------------------------------";

        p = p->next;
    }

    cout << "\n";
}
// Xóa Stack
void NganXepLichSu::xoaHet(){

    while(top != NULL){

        NodeStack *p = top;

        top = top->next;

        delete p;
    }

    size = 0;
}


// Số lượng
int NganXepLichSu::soLuong(){

    return size;
}












