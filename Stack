struct LichSu{

    string hanhDong;

    CongViec congViec;
};


typedef struct nodeStack{

    LichSu data;

    struct nodeStack *next;

}NodeStack;


typedef struct nganxep{

public:

    NodeStack *top;

    int size;

    void khoiTao();

    bool rong();

    void them(LichSu x);

    LichSu layRa();

    void hienThi();

    void xoaHet();

    int soLuong();

}NganXepLichSu;


// Khởi tạo Stack
void NganXepLichSu::khoiTao(){


    top = NULL;

    size = 0;
}
// Kiểm tra rỗng
bool NganXepLichSu::rong(){

    return top == NULL;
}
// Thêm vào Stack
void NganXepLichSu::them(LichSu x){

    NodeStack *p = new NodeStack;

    p->data = x;

    p->next = top;

    top = p;

    size++;
}




